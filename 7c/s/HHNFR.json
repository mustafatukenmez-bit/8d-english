b"},{"kind":"select","options":["a","b","c","d","e","f"],"answer":"d"},{"kind":"select","options":["a","b","c","d","e","f"],"answer":"c"}]},{"title":"Read the cards: True or False?","instr":"Tick T or F.","html":"<div class=\"cols2\"><div><div style=\"border:1pt solid #000;border-radius:3mm;padding:1.5mm 3mm;font-size:9.6pt\"><b>NOAH</b><br>Age: 14<br>165 cm / 55 kg<br>short curly red hair<br>funny, talkative</div></div><div><div style=\"border:1pt solid #000;border-radius:3mm;padding:1.5mm 3mm;font-size:9.6pt\"><b>ADAM</b><br>Age: 12<br>150 cm / 45 kg<br>long straight brown hair<br>shy, hardworking</div></div></div><div class=\"cols2\"><div class=\"row\">1. Adam is younger than Noah. <span class=\"q\" data-i=\"0\"></span></div><div class=\"row\">2. Adam is taller than Noah. <span class=\"q\" data-i=\"1\"></span></div><div class=\"row\">3. Noah is heavier than Adam. <span class=\"q\" data-i=\"2\"></span></div><div class=\"row\">4. Adam has got longer hair than Noah. <span class=\"q\" data-i=\"3\"></span></div><div class=\"row\">5. Noah is quieter than Adam. <span class=\"q\" data-i=\"4\"></span></div></div>","items":[{"kind":"choice","options":["t","f"],"answer":0},{"kind":"choice","options":["t","f"],"answer":1},{"kind":"choice","options":["t","f"],"answer":0},{"kind":"choice","options":["t","f"],"answer":0},{"kind":"choice","options":["t","f"],"answer":1}]}],"vocab":[["belongings","eşyalar"],["hate","nefret etmek"],["stubborn","inatçı"],["curly","kıvırcık"],["light brown","açık kahverengi"],["strict","katı, sert"],["wavy","dalgalı"],["outgoing","dışa dönük"],["punctual","dakik"],["generous","cömert"],["lazy","tembel"],["polite","kibar"],["attractive","çekici"]],"learn":["traits","friends"]}}