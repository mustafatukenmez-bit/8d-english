","options":["a","b","c","d","e","f"],"answer":"c"},{"kind":"select","options":["a","b","c","d","e","f"],"answer":"e"},{"kind":"select","options":["a","b","c","d","e","f"],"answer":"b"},{"kind":"select","options":["a","b","c","d","e","f"],"answer":"d"},{"kind":"select","options":["a","b","c","d","e","f"],"answer":"a"},{"kind":"select","options":["a","b","c","d","e","f"],"answer":"f"}]},{"title":"Meeting a new friend","instr":"Match the questions and answers.","html":"<div class=\"cols2\"><div><div class=\"row\">1. Hello! I&#x27;m Zoe. Nice to meet you. <span class=\"q\" data-i=\"0\"></span></div><div class=\"row\">2. Where are you from? <span class=\"q\" data-i=\"1\"></span></div><div class=\"row\">3. How old are you? <span class=\"q\" data-i=\"2\"></span></div><div class=\"row\">4. Are you new at school? <span class=\"q\" data-i=\"3\"></span></div><div class=\"row\">5. Where is the drama club? <span class=\"q\" data-i=\"4\"></span></div></div><div><div class=\"row\">a) <b>I&#x27;m from Italy.</b></div><div class=\"row\">b) <b>I&#x27;m ten.</b></div><div class=\"row\">c) <b>It&#x27;s downstairs.</b></div><div class=\"row\">d) <b>Nice to meet you, too.</b></div><div class=\"row\">e) <b>Yes, I am.</b></div></div></div>","items":[{"kind":"select","options":["a","b","c","d","e"],"answer":"d"},{"kind":"select","options":["a","b","c","d","e"],"answer":"a"},{"kind":"select","options":["a","b","c","d","e"],"answer":"b"},{"kind":"select","options":["a","b","c","d","e"],"answer":"e"},{"kind":"select","options":["a","b","c","d","e"],"answer":"c"}]}],"vocab":[["quarter","çeyrek"],["past","geçe"],["to","kala"],["hate","nefret etmek"],["dislike","sevmemek"],["ballet","bale"],["how often","ne sıklıkla"],["attend","katılmak"],["age","yaş"],["quarter past","çeyrek geçe"],["always","her zaman"],["popular","sevilen"],["hobby","hobi"]],"learn":["time","likes"]}}