ions":["a","b","c","d","e","f"],"answer":"f"},{"kind":"select","options":["a","b","c","d","e","f"],"answer":"c"},{"kind":"select","options":["a","b","c","d","e","f"],"answer":"d"}]},{"title":"What is the responsibility?","instr":"Match.","html":"<div class=\"cols2\"><div><div class=\"row\">1. I use a cloth on the board. <span class=\"q\" data-i=\"0\"></span></div><div class=\"row\">2. I give water to the flowers. <span class=\"q\" data-i=\"1\"></span></div><div class=\"row\">3. I hold the flag in the ceremony. <span class=\"q\" data-i=\"2\"></span></div><div class=\"row\">4. I give the books to my classmates. <span class=\"q\" data-i=\"3\"></span></div><div class=\"row\">5. I talk to the audience with a microphone. <span class=\"q\" data-i=\"4\"></span></div></div><div><div class=\"row\">a) <b>carry the flag</b></div><div class=\"row\">b) <b>clean the board</b></div><div class=\"row\">c) <b>hand out the books</b></div><div class=\"row\">d) <b>present the programme</b></div><div class=\"row\">e) <b>water the plants</b></div></div></div>","items":[{"kind":"select","options":["a","b","c","d","e"],"answer":"b"},{"kind":"select","options":["a","b","c","d","e"],"answer":"e"},{"kind":"select","options":["a","b","c","d","e"],"answer":"a"},{"kind":"select","options":["a","b","c","d","e"],"answer":"c"},{"kind":"select","options":["a","b","c","d","e"],"answer":"d"}]}],"vocab":[["environment","çevre"],["nature","doğa"],["take care of","korumak"],["walk","yürümek"],["close","yakın"],["on foot","yürüyerek"],["responsibility","sorumluluk"],["responsible","sorumlu"],["usually","genellikle"],["never","asla"],["instrument","çalgı"],["one-third","üçte bir"]],"learn":["interest","transport"]}}